[TEMPLATE]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=your_groq_api_key
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Flowchart symbol detection (used only when "flowchart" is selected explicitly).
SMARTSKETCH_YOLO_ENABLED=true
SMARTSKETCH_YOLO_MODEL=models/flowchart/best.pt
SMARTSKETCH_YOLO_CONF=0.25
SMARTSKETCH_YOLO_IMGSZ=640
SMARTSKETCH_YOLO_DEVICE=auto
FLASK_PORT=5000
MAX_UPLOAD_MB=8
